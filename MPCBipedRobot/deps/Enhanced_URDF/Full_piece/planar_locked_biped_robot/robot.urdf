<?xml version="1.0" ?>
<!-- Onshape document_id: 002729f0ad708412f7e93c74 -->
<robot name="biped_robot">

<!-- Manualy generated -->
<!-- Link world -->
  <link name="world">
    <visual>
      <geometry>
         <box size=".2 .2 .2" />
      </geometry>
      <material name="blue">
	       <color rgba="1 1 1 1" />
      </material>
    </visual>
  </link>

   <link name="base_boom_link">
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0" />
      <geometry>
         <cylinder length="0.6" radius="0.025"/>
      </geometry>
      <material name="blue">
	       <color rgba="0 0 1 1" />
      </material>
    </visual>
  </link>

    <link name="small_link_boom">
    <inertial>
      <origin xyz="0 0.3 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial> 
     <visual>
      <origin xyz="0 0.03 0" rpy="0 0 0" />
      <geometry>
         <box size=".01 0.01 .005" />
      </geometry>
      <material name="red">
	       <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link>

    <link name="boom_link">
    <inertial>
      <origin xyz="0 0.3 0" rpy="0 0 0" />
      <mass value="0" />
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
     <visual>
      <origin xyz="0 0.5475 0" rpy="1.57079 0 0" />
      <geometry>
         <cylinder length="1.095" radius="0.006"/>
      </geometry>
      <material name="blue">
	       <color rgba="0 0 1 1" />
      </material>
    </visual>
  </link>

  <!-- Joint from world to base_boom -->
   <joint name="world_to_base_boom_joint" type="prismatic">
    <parent link="world" />
    <child link="base_boom_link" />
    <axis xyz="1 0 0" /> 
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

   <joint name="base_boom_to_link_boom_joint_z" type="fixed">
    <parent link="base_boom_link" />
    <child link="small_link_boom" />
    <!--<axis xyz="0 0 1" />-->
    <origin xyz="0 0 0.4225" rpy="0 0 0"/>
    <dynamics damping="0" />
  </joint>

    <joint name="base_boom_to_link_boom_joint_x" type="prismatic">
    <parent link="small_link_boom" />
    <child link="boom_link" />
    <axis xyz="0 0 1" />
    <origin xyz="0 0.035 0" rpy="0 0 0"/>
    <dynamics damping="0" />
  </joint>


    <joint name="boom_to_hip_joint" type="fixed">
    <parent link="boom_link" />
    <child link="hips_total_asmb"/>
    <origin xyz="0 1.095 0" rpy="0 0 0"/>
  </joint>

